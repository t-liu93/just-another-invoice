# Copy this file to .env and adjust for local development.
# Docker Compose reads .env automatically for variable interpolation.
# .env is gitignored; .env.example is committed as a template.

# --- PostgreSQL ---
# These are shared between the postgres container and the backend.
# In most cases you only need to override HOST and PORT.
POSTGRES_USER=jai
POSTGRES_PASSWORD=jai
POSTGRES_DB=jai

# Host and port the backend uses to connect to PostgreSQL.
# - Local dev:  localhost + the host-mapped port (see docker-compose.dev.yml).
# - Production: container name (e.g. postgres) + 5432 (default).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional full connection-string override.
# If set, this takes precedence over the POSTGRES_* parts above.
# DATABASE_URL=postgresql+asyncpg://jai:jai@localhost:5433/jai

# --- App ---
# The backend always listens on 8000 in local development and inside Docker.
# Docker Compose publishes the app container only on loopback for a reverse
# proxy; change this host-side port when 12000 is already taken.
APP_HOST_PORT=12000

# Version shown in /api/health response.
APP_VERSION=0.1.0

# Path to frontend build output (used in deployment mode to serve SPA).
# Leave empty or unset for backend-only development.
# STATIC_DIR=/app/static
