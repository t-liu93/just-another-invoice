# Copy this file to .env and fill in real values for local development.
# Docker Compose reads .env automatically for variable interpolation.
# .env is gitignored; .env.example is committed as a template.

# --- PostgreSQL container ---
POSTGRES_USER=jai
POSTGRES_PASSWORD=jai
POSTGRES_DB=jai

# --- Backend database connection ---
# PostgreSQL connection string (asyncpg driver) for host-based local development.
# Keep credentials and database name in sync with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL=postgresql+asyncpg://jai:jai@localhost:5433/jai

# --- App behaviour ---
# Version shown in /api/health response.
APP_VERSION=0.1.0

# Path to frontend build output (used in deployment mode to serve SPA).
# Leave empty or unset for backend-only development.
# STATIC_DIR=/app/static
